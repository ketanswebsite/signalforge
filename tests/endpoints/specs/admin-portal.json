 {
  "route": "POST /api/admin/database/query",
  "body": {},
  "note": "write mode (mode 'write') runs any SQL as given: it is never called here",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403
   },
   {
    "as": "user",
    "status": 403
   },
   {
    "as": "admin",
    "status": 400,
    "note": "requireField query"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "queryRows",
    "body": {
     "query": "SELECT 1 AS one"
    },
    "note": "read mode (the default): one statement in a READ ONLY transaction that is always rolled back (lib/shared/sql-console.js)"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "queryRows",
    "body": {
     "query": "select 1 as one;  ",
     "mode": "readonly"
    },
    "note": "a trailing semicolon is fine"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "query": "SELECT 1 AS one; SELECT 2 AS two"
    },
    "note": "read mode runs one statement: Postgres refuses a second (extended query protocol)"
   },
   {
    "as": "admin",
    "status": 403,
    "body": {
     "query": "WITH gone AS (DELETE FROM users WHERE email = 'nobody-console@e2e.invalid' RETURNING email) SELECT * FROM gone"
    },
    "note": "a write that does not start with a write keyword: the read-only transaction refuses it (25006). The old first-word check ran it"
   },
   {
    "as": "admin",
    "status": 403,
    "body": {
     "query": "CREATE TABLE harness_console_probe (id int)"
    },
    "note": "DDL in read mode: refused"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "query": "SELEC 1"
    },
    "note": "a syntax error is the admin's to read: 400 with Postgres's message (it was a 500)"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "query": 42
    },
    "note": "query must be text"
   }
  ]
