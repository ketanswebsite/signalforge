 {
  "route": "POST /api/alerts/preferences",
  "body": {
   "telegram_enabled": true,
   "alert_on_buy": true,
   "alert_on_target": true,
   "alert_on_stoploss": true,
   "alert_on_time_exit": true
  },
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403,
    "body": {
     "telegram_enabled": "banana"
    },
    "note": "the subscription gate answers first; the body could never be stored, so nosub cannot gain a row even if the gate broke"
   },
   {
    "as": "user",
    "status": 200,
    "check": "object",
    "note": "the same values the seed stored: an effective no-op"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "body": {},
    "note": "an empty body upserts the defaults for the whitelisted columns"
   },
   {
    "as": "user",
    "status": 400,
    "body": {
     "telegram_enabled": "banana"
    },
    "bug": "no type validation: a non-boolean telegram_enabled goes straight into the upsert (server.js:3255-3260, database-postgres.js:2058) and Postgres rejects it (invalid input syntax for type boolean) -> 500; nothing is written"
   }
  ]
 },
