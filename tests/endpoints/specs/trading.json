    "note": "the analysis token is not a session; only the pre-gate ops routes take it"
   },
   {
    "as": "nosub",
    "status": 200,
    "check": "object",
    "note": "the Scanner signals feed is visible to every signed-in account (no subscription gate by design)"
   },
   {
    "as": "user",
    "status": 200,
    "check": "object"
   },
   {
    "as": "user",
    "path": "/api/signals/recent?days=abc",
    "status": 200,
    "check": "object",
    "note": "unparsable days falls back to 7"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "object"
   }
  ]
 },
