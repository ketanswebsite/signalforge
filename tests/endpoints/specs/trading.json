 {
  "route": "POST /api/push/subscribe",
  "body": {
   "subscription": {
    "endpoint": "https://push.e2e.invalid/harness-delete-1",
    "keys": {
     "p256dh": "harness-p256dh",
     "auth": "harness-auth"
    }
   },
   "userAgent": "harness"
  },
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 400,
    "body": {},
    "note": "no subscription gate; validation answers first (nosub is never given a valid body)"
   },
   {
    "as": "user",
    "status": 400,
    "body": {},
    "note": "'Invalid subscription data'"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "note": "fake .invalid endpoint on the throwaway persona"
   },
   {
    "as": "user",
    "status": 400,
    "body": {
     "subscription": {
      "endpoint": "https://push.e2e.invalid/harness-user-nokeys",
      "keys": {}
     }
    },
    "bug": "keys are only checked for presence: an empty keys object passes server.js:3288 and the INSERT hits NOT NULL keys_p256dh (database-postgres.js:3603; keys_p256dh is NOT NULL at database-postgres.js:387) -> 500 'Failed to save subscription'"
   }
  ]
 },
 {
  "route": "POST /api/push/unsubscribe",
