 {
  "route": "GET /api/trades/:id",
  "path": "/api/trades/{userActiveTradeId}",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403
   },
   {
    "as": "user",
    "status": 200,
    "check": "object"
   },
   {
    "as": "user",
    "path": "/api/trades/{userClosedTradeId}",
    "status": 200,
    "check": "object"
   },
   {
    "as": "user",
    "path": "/api/trades/{deleteTradeId}",
    "status": 404,
    "note": "another user's trade: the lookup is scoped to the caller"
   },
   {
    "as": "user",
    "path": "/api/trades/999999999",
    "status": 404
   },
   {
    "as": "user",
    "path": "/api/trades/not-a-number",
    "status": 404,
    "note": "getTradeById swallows the bigint cast error and returns null"
   },
   {
    "as": "admin",
    "status": 404,
    "note": "owner-scoped even for the admin"
   }
  ]
 },
 {
  "route": "POST /api/trades",
  "body": {
   "symbol": "HARNESS.L",
   "name": "Harness plc",
   "entryDate": "2026-09-21T08:00:00.000Z",
   "entryPrice": 100,
   "shares": 2,
   "targetPrice": 108,
   "stopLossPercent": 5,
   "investmentAmount": 200,
   "market": "UK",
   "currencySymbol": "£"
  },
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403,
    "body": {},
    "note": "the subscription gate answers first (an empty body, so nosub cannot gain a trade even if the gate broke)"
   },
   {
    "as": "delete",
    "status": 201,
    "check": "object",
    "note": "valid manual trade on the throwaway persona"
   },
   {
    "as": "user",
    "status": 400,
    "body": {},
    "bug": "no body validation: POST /api/trades hands {} straight to TradeDB.insertTrade (server.js:2369-2382) and Postgres rejects the NULL symbol (database-postgres.js:1752; trades.symbol is NOT NULL at database-postgres.js:31) -> 500 with the raw constraint message"
   }
  ]
 },
 {
  "route": "PUT /api/trades/:id",
  "path": "/api/trades/{deleteTradeId}",
  "body": {
   "notes": "harness note"
  },
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403
   },
   {
    "as": "user",
    "status": 404,
    "note": "another user's trade: the lookup is scoped to the caller, nothing is written"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "note": "plain field update"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "body": {
     "status": "closed",
     "exitPrice": 101,
     "exitDate": "2026-09-22T15:00:00.000Z",
     "exitReason": "Manual exit (harness)"
    },
    "note": "active -> closed goes through closeTradeAndRelease (manual trade: no capital release)"
   },
   {
    "as": "user",
    "path": "/api/trades/{userActiveTradeId}",
    "status": 400,
    "body": {},
    "bug": "an update with no updatable field answers 404 'Trade not found' for a trade that exists (it was just loaded at server.js:2391): TradeDB.updateTrade returns null when nothing is set (database-postgres.js:1883) and server.js:2422-2425 maps that null to 404"
   }
  ]
 },
 {
  "route": "POST /api/trades/bulk",
  "body": {
   "trades": [
    {
     "symbol": "HARNESS.L",
     "stockName": "Harness plc",
     "entryDate": "2026-09-19T08:00:00.000Z",
     "entryPrice": 100,
     "shares": 1,
     "status": "active"
    }
   ]
  },
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403,
    "body": {},
    "note": "the subscription gate answers first (an empty body, so nosub cannot gain a trade even if the gate broke)"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "note": "imports one trade for the throwaway persona"
   },
   {
    "as": "user",
    "status": 400,
    "body": {},
    "bug": "no validation of body.trades: server.js:2459-2468 passes undefined to TradeDB.bulkInsertTrades, whose for...of throws 'trades is not iterable' (database-postgres.js:1946) -> 500"
   }
  ]
 },
