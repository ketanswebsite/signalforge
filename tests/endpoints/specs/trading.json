[
 {
  "route": "GET /api/user/auto-trading",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 200,
    "check": "object",
    "note": "reading your own auto-trading switch has no subscription gate (server.js:1094)"
   },
   {
    "as": "user",
    "status": 200,
    "check": "object"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "object"
   }
  ]
 },
 {
  "route": "POST /api/user/auto-trading",
  "body": {
   "enabled": false
  },
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403,
    "body": {
     "enabled": false
    },
    "note": "ensureSubscriptionActive: no subscription -> 403 before the handler (body is the default state, so nosub cannot change even if the gate broke)"
   },
   {
    "as": "user",
    "status": 200,
    "check": "object",
    "note": "user starts disabled, so this is a no-op write"
   },
   {
    "as": "user",
    "status": 200,
    "check": "object",
    "body": {},
    "note": "fail-safe by design: anything but enabled === true turns auto-trading off (server.js:1110)"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "body": {
     "enabled": true
    },
    "note": "happy path on the throwaway persona"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "body": {
     "enabled": false
    },
    "note": "switch it back off"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "object",
    "note": "admin bypasses the subscription gate; admin starts disabled so this is a no-op"
   }
  ]
 },
 {
  "route": "GET /api/signals/recent",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "token",
