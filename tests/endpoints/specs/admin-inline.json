   },
   {
    "as": "nosub",
    "status": 403,
    "body": {}
   },
   {
    "as": "user",
    "status": 403,
    "body": {
     "email": "harness-user@e2e.invalid",
     "chatId": "-1000000000001"
    },
    "note": "a well-formed link request from a non-admin is refused before the handler"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {},
    "note": "Email and Chat ID are required"
   },
   {
    "as": "admin",
    "status": 400,
    "note": "Fixed 2026-09-23: the Express 4 req.body default is restored (server.js)."
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "email": "harness-victim@e2e.invalid",
     "chatId": "-1999999999999"
    },
    "note": "unknown chat id: 'Telegram user not found or not subscribed', nothing written"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "email": "harness-victim@e2e.invalid",
     "chatId": "not-a-chat-id"
    },
    "note": "Fixed in IV: validated before it reaches Postgres."
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "email": "harness-ghost@e2e.invalid",
     "chatId": "-1000000000001"
    },
    "note": "unknown account: 'OAuth user not found', nothing written"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "object",
    "body": {
     "email": "harness-victim@e2e.invalid",
     "chatId": "-1000000000001"
    },
    "note": "links the victim to the seeded harness subscriber; the manual-unlink spec right after this one undoes it"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "email": "harness-victim@e2e.invalid",
     "chatId": 1.5
    },
    "note": "a chat id is a whole number"
   }
  ]
 },
