    "status": 401,
    "body": {
     "exitPrice": 105,
     "exitReason": "Harness manual close"
    }
   },
   {
    "as": "nosub",
    "status": 403,
    "body": {
     "exitPrice": 105,
     "exitReason": "Harness manual close"
    }
   },
   {
    "as": "user",
    "status": 403,
    "body": {
     "exitPrice": 105,
     "exitReason": "Harness manual close"
    },
    "note": "a well-formed close from a non-admin is refused before the handler"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {},
    "note": "exitPrice and exitReason required"
   },
   {
    "as": "admin",
    "status": 400,
    "note": "Fixed 2026-09-23: the Express 4 req.body default is restored (server.js)."
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "exitPrice": "not-a-price",
     "exitReason": "Harness manual close"
    },
    "note": "Fixed in IV: validated before it reaches Postgres."
   },
   {
    "as": "admin",
    "status": 404,
    "path": "/api/portfolio/close-trade/HARNESSZ.L",
    "body": {
     "exitPrice": 105,
     "exitReason": "Harness manual close"
    },
    "note": "no active high-conviction position in that symbol"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "object",
    "body": {
     "exitPrice": 105,
     "exitReason": "Harness manual close"
    },
    "note": "closes the seeded HARNESSH.L position (order last: every other spec that reads it has run); no bot token, so the exit broadcast is a no-op"
   },
   {
    "as": "admin",
    "status": 404,
    "body": {
     "exitPrice": 105,
     "exitReason": "Harness manual close"
    },
    "note": "a second close finds no active position: 404, no second alert"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "exitPrice": 0,
     "exitReason": "Harness manual close"
    },
    "note": "a price of zero"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "exitPrice": "-5",
     "exitReason": "Harness manual close"
    },
