 {
  "route": "POST /api/admin/push/broadcast",
  "note": "with VAPID keys set, an admin call sends to every subscribed browser: the harness never has keys (preload.js)",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 403
   },
   {
    "as": "user",
    "status": 403,
    "note": "not an admin: 403 at the /api/admin guard"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {},
    "note": "a title and a message are required"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "title": "Harness",
     "body": "Harness message",
     "url": "https://example.invalid/"
    },
    "note": "a click opens a page of this site only"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "title": "Harness",
     "body": "Harness message",
     "url": "//example.invalid/"
    },
    "note": "a protocol-relative address is another site too"
   },
   {
    "as": "admin",
    "status": 503,
    "body": {
     "title": "Harness",
     "body": "Harness message",
     "url": "/index.html"
    },
    "note": "web push is not configured in the harness, so nothing is sent. The Settings tab broadcasts through this route; until I12b it also required the email to be in ADMIN_EMAILS, a variable nothing else reads"
   }
  ]
 },
