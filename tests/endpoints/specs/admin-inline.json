    "note": "Chat ID is required"
   },
   {
    "as": "admin",
    "status": 400,
    "note": "Fixed 2026-09-23: the Express 4 req.body default is restored (server.js)."
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "chatId": "not-a-chat-id"
    },
    "note": "Fixed in IV: validated before it reaches Postgres."
   },
   {
    "as": "admin",
    "status": 200,
    "check": "object",
    "body": {
     "chatId": "-1999999999999"
    },
    "note": "unknown chat id: the soft-delete (is_active=false) matches no row and the handler reports success (idempotent removal); the seeded subscriber other specs read is never deactivated"
   },
   {
    "as": "admin",
    "status": 400,
    "body": {
     "chatId": "12.5"
    },
    "note": "a chat id is a whole number"
   }
  ],
  "order": "last",
  "note": "order last: a bulk-destructive admin handler. Its only writing case targets a row that does not exist, so it changes nothing today; running it last keeps any future regression from reaching data that other specs read."
 },
