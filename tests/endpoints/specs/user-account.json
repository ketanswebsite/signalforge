   },
   {
    "as": "nosub",
    "status": 404,
    "note": "Fixed 2026-09-23: the Express 4 req.body default is restored (server.js)."
   },
   {
    "as": "trial",
    "status": 200,
    "check": "object",
    "body": {
     "reason": "harness lifecycle test"
    },
    "note": "lifecycle 3/5: cancels the trial started above"
   },
   {
    "as": "trial",
    "status": 404,
    "check": "object",
    "body": {},
    "note": "lifecycle 4/5: nothing active is left to cancel"
   }
  ]
 },
 {
  "route": "POST /api/user/subscription/reactivate",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 404,
    "check": "object",
    "note": "nothing cancelled to reactivate (read-only)"
   },
   {
    "as": "user",
    "status": 404,
    "check": "object",
    "note": "the user's live trial is not cancelled (read-only)"
   },
   {
    "as": "trial",
    "status": 200,
    "check": "object",
    "bug": "lifecycle 5/5: a cancelled trial can never be reactivated - the lookup requires subscription_end_date > NOW() (routes/subscription.js:329), but start-trial (routes/subscription.js:422-451) writes only trial_end_date, so the NULL end date never matches and the route answers 404, although the account page offers \"Reactivate my plan\" for every cancelled plan and the trial period has not ended"
   }
  ]
 },
