   },
   {
    "as": "token",
    "status": 401
   },
   {
    "as": "readtoken",
    "status": 401,
    "note": "the read token is not a session: 401 at the /api sign-in gate"
   },
   {
    "as": "admin",
    "status": 403,
    "note": "the admin account owns the house portfolio (the executor books every signal to it): refused before anything is touched"
   },
   {
    "as": "delete",
    "status": 200,
    "check": "object",
    "note": "trial row plus a paid payment tied to it (seed.sql): archives the payment records, deletes every row the account owns, then the account"
   },
   {
    "as": "delete",
    "status": 401,
    "note": "the session ended with the account, and the server is still up: the old handler destroyed the session while passport was still logging out, and passport's callback threw and killed the process"
   }
  ],
  "note": "This file is named user-account.json so that it sorts after trading.json. The delete persona is still used by trading.json's order-last DELETE /api/trades specs, and a fixed delete-account ends that persona's session and deletes its user row."
 }
