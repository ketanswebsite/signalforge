 {
  "route": "POST /api/user/subscription/start-trial",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "user",
    "status": 400,
    "check": "object",
    "note": "ALREADY_SUBSCRIBED: the seeded live trial blocks a second one (no write)"
   },
   {
    "as": "trial",
    "path": "/api/user/auto-trading",
    "body": {
     "enabled": false
    },
    "status": 403,
    "check": "object",
    "note": "before: the trial persona has never started a trial (status none), so the subscription gate refuses it. This probe (enabled:false is a no-op write) is the control for the access probes below"
   },
   {
    "as": "trial",
    "status": 200,
    "check": "object",
    "note": "lifecycle 1/6: the trial persona starts its free trial"
   },
   {
    "as": "trial",
    "path": "/api/user/auto-trading",
    "body": {
     "enabled": false
    },
    "status": 200,
    "check": "object",
    "note": "after: the new trial opens the subscription gate"
   },
   {
    "as": "trial",
    "status": 400,
    "check": "object",
    "note": "lifecycle 2/6: a second start while the trial runs is refused (ALREADY_SUBSCRIBED)"
   }
  ]
 },
 {
  "route": "POST /api/user/subscription/cancel",
  "cases": [
   {
    "as": "anon",
    "status": 401,
    "body": {}
   },
   {
    "as": "nosub",
    "status": 404,
    "body": {},
    "check": "object",
    "note": "No active subscription found (read-only for nosub)"
   },
   {
    "as": "nosub",
    "status": 404,
    "note": "Fixed 2026-09-23: the Express 4 req.body default is restored (server.js)."
   },
   {
    "as": "trial",
    "status": 200,
    "check": "object",
    "body": {
     "reason": "harness lifecycle test"
    },
    "note": "lifecycle 3/6: cancels the trial started above"
   },
   {
    "as": "trial",
    "path": "/api/user/auto-trading",
    "body": {
     "enabled": false
    },
    "status": 200,
    "check": "object",
    "note": "the cancelled trial keeps access until its trial end date: the cancel writes that end into end_date and middleware/subscription.js keeps a cancelled row active until then (until 2026-09-24 the gate refused at once)"
   },
   {
    "as": "trial",
    "status": 404,
    "check": "object",
    "body": {},
    "note": "lifecycle 4/6: nothing running is left to cancel"
   },
   {
    "as": "trial",
    "path": "/api/user/subscription/start-trial",
    "status": 409,
    "check": "object",
    "note": "lifecycle 5/6: one free trial per account - a cancelled trial is never started again (TRIAL_USED; until 2026-09-24 this wrote a second 90-day trial)"
   }
  ]
 },
 {
  "route": "POST /api/user/subscription/reactivate",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "nosub",
    "status": 404,
    "check": "object",
    "note": "nothing cancelled to reactivate (read-only)"
   },
   {
    "as": "user",
    "status": 404,
    "check": "object",
    "note": "the user's live trial is not cancelled (read-only)"
   },
   {
    "as": "trial",
    "status": 200,
    "check": "object",
    "note": "lifecycle 6/6: the cancelled trial comes back as a trial with the same end date - no extra free days, never a paid active row (until 2026-09-24 the lookup required subscription_end_date, which start-trial never writes, so this was 404)"
   },
   {
    "as": "trial",
    "path": "/api/user/subscription/start-trial",
    "status": 400,
    "check": "object",
    "note": "after: the row runs again, so a new start is ALREADY_SUBSCRIBED (a row still cancelled would answer 409 TRIAL_USED)"
   },
   {
    "as": "trial",
    "status": 404,
    "check": "object",
    "note": "after: nothing cancelled is left to reactivate"
   }
  ]
 },
