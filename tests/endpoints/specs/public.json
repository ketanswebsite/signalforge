    "check": "redirectLogin",
    "note": "consent declined -> failureRedirect /login?error=auth_failed, which login.html:56 surfaces"
   },
   {
    "as": "anon",
    "path": "/auth/google/callback?error=server_error",
    "status": 302,
    "check": "redirectLogin",
    "note": "Fixed in I5: an error handler on the callback chain redirects to the login page."
   }
  ]
 },
