[
 {
  "route": "GET /login",
  "cases": [
   {
    "as": "anon",
    "status": 200,
    "check": "html",
    "note": "sign-in page (routes/auth.js:6)"
   },
   {
    "as": "token",
    "status": 200,
    "check": "html",
    "note": "the ops token is not a session"
   },
   {
    "as": "nosub",
    "status": 302,
    "note": "already signed in -> redirect to /"
   },
   {
    "as": "user",
    "status": 302
   },
   {
    "as": "admin",
    "status": 302
   }
  ]
 },
 {
  "route": "GET /auth/google",
  "cases": [
   {
    "as": "anon",
    "status": 302,
    "note": "passport redirects to the Google consent screen; nothing leaves the machine"
   },
   {
    "as": "user",
    "status": 302
   }
  ]
 },
 {
  "route": "GET /auth/google/callback",
  "cases": [
   {
    "as": "anon",
    "status": 302,
    "note": "no ?code -> passport-oauth2 restarts the authorization (redirect to Google)"
   },
   {
    "as": "anon",
    "path": "/auth/google/callback?error=access_denied",
    "status": 302,
    "check": "redirectLogin",
    "note": "consent declined -> failureRedirect /login?error=auth_failed, which login.html:56 surfaces"
   },
   {
    "as": "anon",
    "path": "/auth/google/callback?error=server_error",
    "status": 302,
    "check": "redirectLogin",
    "note": "Fixed in I5: an error handler on the callback chain redirects to the login page."
   }
  ]
 },
 {
  "route": "GET /api/user",
  "cases": [
   {
    "as": "anon",
    "status": 200,
    "check": "authenticatedFalse",
    "note": "routes/auth.js:110 answers before the /api gate: a public who-am-I"
   },
   {
    "as": "token",
    "status": 200,
    "check": "authenticatedFalse"
   },
   {
    "as": "nosub",
    "status": 200,
    "check": "authenticatedTrue"
   },
   {
    "as": "user",
    "status": 200,
    "check": "authenticatedTrue"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "authenticatedTrue"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "isAdminTrue",
    "note": "Fixed in I5: routes/auth.js reports isAdmin with the admin guard's own check."
   }
  ]
 },
 {
  "route": "POST /api/telegram/webhook",
  "body": {},
  "cases": [
   {
    "as": "anon",
    "status": 403,
    "note": "TELEGRAM_WEBHOOK_SECRET is set and no x-telegram-bot-api-secret-token header is sent (server.js:223)"
   },
   {
    "as": "token",
    "status": 403
   },
   {
    "as": "user",
    "status": 403
   },
   {
    "as": "admin",
    "status": 403,
    "body": {
     "update_id": 1,
     "message": {
      "message_id": 1,
      "from": {
       "id": 1,
       "first_name": "Harness"
      },
      "chat": {
       "id": 1,
       "type": "private"
      },
      "text": "/start"
     }
    },
    "note": "a well-formed update is still refused without the secret header"
   }
  ]
 },
