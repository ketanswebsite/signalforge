 {
  "route": "GET /api/ops/telegram-stats",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "anon",
    "status": 401,
    "path": "/api/ops/telegram-stats?token=harness-wrong-token",
    "note": "header only: a token in the URL is never read"
   },
   {
    "as": "user",
    "status": 401,
    "note": "a signed-in session is not the ops token"
   },
   {
    "as": "admin",
    "status": 401
   },
   {
    "as": "token",
    "status": 200,
    "check": "telegramStats",
    "note": "read-only (GAPS #12): today's Telegram messages by kind, sent and not delivered with Telegram's reason, and the daily totals; the harness has no bot, so every count is zero, but the table exists from boot, so the queries run"
   },
   {
    "as": "token",
    "status": 200,
    "check": "telegramStatsWindow",
    "path": "/api/ops/telegram-stats?day=2026-09-23&days=90"
   },
   {
    "as": "token",
    "status": 200,
    "check": "telegramStats",
    "path": "/api/ops/telegram-stats?days=abc",
    "note": "a malformed window is the default 14 days, as conviction-stats reads one"
   },
   {
    "as": "token",
    "status": 400,
    "path": "/api/ops/telegram-stats?day=2026-02-30",
    "note": "not a real date"
   },
   {
    "as": "readtoken",
    "status": 200,
    "check": "telegramStats",
    "note": "read-only probe: the read token opens it (header)"
   },
   {
    "as": "readtoken",
    "path": "/api/ops/telegram-stats?day=2026-02-30",
    "status": 400,
    "note": "the read token reaches the handler: its own 400 for an impossible date"
   },
   {
    "as": "anon",
    "path": "/api/ops/telegram-stats?token={fullToken}",
    "status": 401,
    "note": "header only: not even the full token is read from the URL here"
   },
   {
    "as": "anon",
    "path": "/api/ops/telegram-stats?token={readToken}",
    "status": 401,
    "note": "the read token is never read from the URL"
   }
  ]
 },
 {
  "route": "GET /api/ops/dead-tickers",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "anon",
    "path": "/api/ops/dead-tickers?token=harness-wrong-token",
    "status": 401
   },
   {
    "as": "user",
    "status": 401,
    "note": "a signed-in session is not the ops token"
   },
   {
    "as": "admin",
    "status": 401
   },
   {
    "as": "token",
    "status": 200,
    "check": "deadTickers",
    "note": "read-only: the dead-ticker record (GAPS #10). Nothing is recorded here (the scan and the market-cap refresh never run), so no symbol reads dead; the rule, the switch (off) and the universe by market are stated"
   },
   {
    "as": "readtoken",
    "status": 200,
    "check": "deadTickers",
    "note": "read-only probe: the read token opens it (header)"
   },
   {
    "as": "anon",
    "path": "/api/ops/dead-tickers?token={fullToken}",
    "status": 401,
    "note": "header only: a new token route never reads ?token= (README rule 15)"
   },
   {
    "as": "anon",
    "path": "/api/ops/dead-tickers?token={readToken}",
    "status": 401,
    "note": "the read token is never read from the URL"
   }
  ]
 },
 {
  "route": "GET /api/fx/rates",
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "token",
    "status": 401,
    "note": "the ops token does not pass the /api sign-in gate"
   },
   {
    "as": "readtoken",
    "status": 401,
    "note": "the read token is not a session"
   },
   {
    "as": "nosub",
    "status": 403,
    "note": "ensureSubscriptionActive, like the Simulator's other routes"
   },
   {
    "as": "user",
    "status": 200,
    "check": "fxRates",
    "note": "GAPS #11: the 365 days up to today with the rates in force each day; no day while nothing is stored (the harness never refreshes)"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "fxRates",
    "note": "admin bypasses the subscription gate"
   },
   {
    "as": "user",
    "path": "/api/fx/rates?from=2026-09-01&to=2026-09-10",
    "status": 200,
    "check": "fxRatesWindow"
   },
   {
    "as": "user",
    "path": "/api/fx/rates?from=2026-02-30",
    "status": 400,
    "note": "not a real date"
   },
   {
    "as": "user",
    "path": "/api/fx/rates?to=abc",
    "status": 400
   },
   {
    "as": "user",
    "path": "/api/fx/rates?from=2026-09-01&from=2026-09-02",
    "status": 400,
    "note": "a repeated parameter arrives as a list"
   },
   {
    "as": "user",
    "path": "/api/fx/rates?from=2026-09-10&to=2026-09-01",
    "status": 400,
    "note": "from after to"
   },
   {
    "as": "user",
    "path": "/api/fx/rates?from=2010-01-01&to=2026-09-01",
    "status": 400,
    "note": "more than 4000 days a request"
   }
  ]
 }
