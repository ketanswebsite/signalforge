 {
  "route": "POST /api/prices",
  "body": {
   "symbols": [
    "HARNESS.L"
   ]
  },
  "cases": [
   {
    "as": "anon",
    "status": 401
   },
   {
    "as": "token",
    "status": 401,
    "note": "the ops token does not pass the /api sign-in gate"
   },
   {
    "as": "nosub",
    "status": 403,
    "note": "ensureSubscriptionActive"
   },
   {
    "as": "user",
    "status": 400,
    "body": {},
    "note": "no symbols"
   },
   {
    "as": "user",
    "status": 400,
    "body": {
     "symbols": "HARNESS.L"
    },
    "note": "symbols must be an array"
   },
   {
    "as": "user",
    "status": 400,
    "body": {
     "symbols": []
    }
   },
   {
    "as": "user",
    "status": 200,
    "check": "object",
    "note": "price for a fixture symbol"
   },
   {
    "as": "admin",
    "status": 200,
    "check": "object",
    "body": {
     "symbols": [
      "HARNESS.L",
      "HARNESSP.L"
     ]
    }
   },
   {
    "as": "user",
    "status": 400,
    "body": {
     "symbols": [
      123
     ]
    },
    "note": "Fixed in IV: validated before it reaches Postgres."
   },
   {
    "as": "user",
    "status": 400,
    "body": {
     "symbols": [
      "HARNESS.L",
      ""
     ]
    },
    "note": "an empty symbol"
