   {
    "as": "logout",
    "path": "/api/auth/status",
    "status": 200,
    "check": "authenticatedTrue",
    "note": "before: the logout persona is signed in"
   },
   {
    "as": "logout",
    "status": 302,
    "check": "redirectLogin"
   },
   {
    "as": "logout",
    "path": "/api/auth/status",
    "status": 200,
    "check": "authenticatedFalse",
