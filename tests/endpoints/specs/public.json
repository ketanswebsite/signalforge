 },
 {
  "route": "GET /auth/google/callback",
  "cases": [
   {
    "as": "anon",
    "status": 302,
    "note": "no ?code -> passport-oauth2 restarts the authorization (redirect to Google)"
   },
   {
    "as": "anon",
    "path": "/auth/google/callback?error=access_denied",
